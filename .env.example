# Production site origin with no path or trailing slash, using https.
# Set this in the Vercel Production environment after the custom domain is confirmed.
# Use the exact public hostname (www or non-www) you want indexed.
# Leave unset on preview and development builds. Do not use the Vercel preview URL.
VITE_SITE_URL=

# Public Formspree form URL. Safe for client-side use; not a secret.
# Set the same value in the Vercel Production environment, then redeploy.
# Vite inlines this at build time, so a redeploy is required after changing it.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/xrpgagky

# Local development only. Ignored in production builds.
# Use success or error to preview those UI states without calling Formspree.
# VITE_FORMSPREE_MOCK=
